#!/usr/bin/env bash
# Copy this file to load_api_keys.sh and fill in your API keys.
# load_api_keys.sh is gitignored — never commit real keys.

# The shipped config/config.yaml runs all four agents on DeepSeek, so this is the only key a
# first run needs.
export DEEPSEEK_API_KEY='sk-...'

# Needed only if you point an agent at one of these providers instead.
# export OPENAI_API_KEY='sk-proj-...'
# export GOOGLE_API_KEY='AIza...'
# export ANTHROPIC_API_KEY='sk-ant-...'
# export Z_AI_API_KEY='...'
# export MINIMAX_API_KEY='sk-...'
